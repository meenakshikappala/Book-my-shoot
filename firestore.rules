rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 & Phase 4.1: Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredCity', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'preferredCity', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.preferredCity is string && data.preferredCity.size() >= 1 && data.preferredCity.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: Booking
    function isValidCategory(cat) {
      return cat is string && cat.size() >= 1 && cat.size() <= 40 && (
        cat == 'Wedding' ||
        cat == 'Pre-Wedding' ||
        cat == 'Birthday' ||
        cat == 'Portrait' ||
        cat == 'Fashion' ||
        cat == 'Events' ||
        cat == 'Product Photography' ||
        cat == 'Travel Photography'
      );
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'userId', 'clientName', 'photographerId', 'photographerName',
          'category', 'shootDate', 'shootTime', 'location',
          'hours', 'packageName', 'totalPrice', 'notes',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'clientName', 'photographerId', 'photographerName',
          'category', 'shootDate', 'shootTime', 'location',
          'hours', 'packageName', 'totalPrice', 'notes',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 80
        && data.photographerId is string && data.photographerId.size() >= 1 && data.photographerId.size() <= 64 && data.photographerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.photographerName is string && data.photographerName.size() >= 1 && data.photographerName.size() <= 80
        && isValidCategory(data.category)
        && data.shootDate is string && data.shootDate.size() == 10 && data.shootDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.shootTime is string && data.shootTime.size() >= 1 && data.shootTime.size() <= 30
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 140
        && data.hours is int && data.hours >= 1 && data.hours <= 12
        && data.packageName is string && data.packageName.size() >= 1 && data.packageName.size() <= 60
        && data.totalPrice is number && data.totalPrice >= 50 && data.totalPrice <= 50000
        && data.notes is string && data.notes.size() <= 500
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 20
        && (data.status == 'confirmed' || data.status == 'completed' || data.status == 'cancelled')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ContactInquiry
    function isValidInquiry(data) {
      return data.keys().hasAll(['userId', 'name', 'subject', 'category', 'message', 'createdAt'])
        && data.keys().hasOnly(['userId', 'name', 'subject', 'category', 'message', 'createdAt'])
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 1000
        && data.createdAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredCity', 'updatedAt']);

      allow delete: if false;
    }

    // Collection: /bookings/{bookingId}
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().status == 'confirmed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && existing().userId == request.auth.uid
        && existing().status == 'confirmed'
        && incoming().userId == existing().userId
        && incoming().photographerId == existing().photographerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Cancel Booking
          (incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          ||
          // Action 2: Reschedule or Update Notes
          (incoming().status == 'confirmed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['shootDate', 'shootTime', 'location', 'notes', 'updatedAt']))
        );

      allow delete: if false;
    }

    // Collection: /inquiries/{inquiryId}
    match /inquiries/{inquiryId} {
      allow get: if isSignedIn() && isValidId(inquiryId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if false;
      allow delete: if false;
    }
  }
}
